Options -Indexes
DirectoryIndex index.php index.html
ErrorDocument 404 /404.php
<IfModule mod_rewrite.c>
RewriteEngine On

# Enforce HTTPS first to avoid redirect chains.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^localhost$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Canonical clean URLs for service pages.
RewriteCond %{THE_REQUEST} \s/+services/([a-z0-9-]+)\.php(?:[\s?]) [NC]
RewriteRule ^services/([a-z0-9-]+)\.php$ /services/$1/ [R=301,L,NE]
RewriteRule ^services/([a-z0-9-]+)/?$ services/$1.php [L,QSA]

RewriteRule ^gallery/?$ gallery/index.php [L,QSA]
RewriteRule ^stories/udaipur-solo-trip/?$ stories/udaipur-solo-trip.php [L,QSA]
RewriteRule ^blogs/3-day-solo-udaipur-trip-swiggywala/?$ blogs/udaipur-solo-trip-story.php [L,QSA]
RewriteRule ^blogs/?$ blogs/index.php [L,QSA]
RewriteRule ^blogs/([a-z0-9-]+)/?$ blogs/post.php?slug=$1 [L,QSA]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
</IfModule>
